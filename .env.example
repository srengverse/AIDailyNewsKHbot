# Google Gemini API key. Create it in Google AI Studio.
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-2.5-flash

# Supabase Project Settings > API.
# Use the service_role key only in this trusted server-side bot; never expose it in a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Meta Page access token and Page ID.
FACEBOOK_PAGE_ID=replace_with_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=replace_with_page_access_token
FACEBOOK_GRAPH_API_VERSION=v26.0

# Bot behavior.
TIMEZONE=Asia/Phnom_Penh
POST_TIME=07:00
AUTO_PUBLISH=false
REQUIRE_APPROVAL=true
POSTER_OUTPUT_DIR=output
FONT_PATH=Battambang-Bold.ttf
MAX_DAILY_POSTS=1
PORT=8080
LOG_LEVEL=INFO
